# .env.local 은 절대 커밋하지 마세요.

# ── 생성형 AI (Google Gemini) ──────────────────────────────────────
#
# 발급: https://aistudio.google.com/apikey → Create API key  (2분, 카드 불필요)
#
# ⚠️ **Set up Billing 은 누르지 마세요.** 누르는 순간 유료 티어로 올라가고
#    지출 상한이 사라집니다. 결제 수단을 등록하지 않으면 무료 티어에 고정되어
#    과금이 구조적으로 불가능합니다 — 그게 곧 지출 상한입니다.
#    (대신 분당·일일 요청 제한이 있습니다. 걸리면 폴백 문장으로 떨어집니다)
GEMINI_API_KEY=

# 무료 티어는 flash 계열만 쓸 수 있습니다 (gemini-2.5-pro 는 유료 전용).
# 비워 두면 코드 기본값(gemini-3.1-flash-lite)을 씁니다 — 무료 키로도 계속 응답합니다.
#
# ⚠️ 모델 고를 때 걸리는 지뢰 둘:
#    gemini-3.6-flash  무료 티어 일일 한도가 모델당 20회라 제일 먼저 마릅니다(429).
#                      유료 키면 문제 없습니다 — 배포본은 이 모델을 씁니다.
#    gemini-2.5-flash  신규 사용자에게 404. 그런데 모델 목록 API 에는 아직 보입니다.
GEMINI_MODEL=

# ── Supabase (선택) ────────────────────────────────────────────────
# 없어도 앱은 그대로 뜹니다. 등록한 화물·사업계획서 초안이 프로세스 메모리에만
# 남아 서버가 갈릴 때 사라질 뿐입니다. 심사위원이 며칠에 걸쳐 테스트하는 상황이면
# 반드시 넣으세요 — 그게 이 DB 를 붙인 이유입니다.
#
# 발급: https://supabase.com → 프로젝트 → Project Settings → API
#   Project URL  → SUPABASE_URL
#   service_role → SUPABASE_SERVICE_ROLE_KEY   (anon 키가 아닙니다)
#
# ⚠️ service_role 키는 RLS 를 우회합니다. **NEXT_PUBLIC_ 접두어를 붙이지 마세요.**
#    붙는 순간 브라우저 번들에 박혀서 DB 전체가 공개됩니다.
#    이 앱은 브라우저에서 DB 를 직접 부르지 않습니다 (전부 /api/* 경유).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=