# 인증은 아래 둘 중 **하나만** 있으면 됩니다. .env.local 은 절대 커밋하지 마세요.
#
# (A) 계정 세션으로 돌리기 — 키 발급이 필요 없습니다. 권장.
#     루트에서 `npm run session-token` 을 실행하면 이 값이 자동으로 채워집니다.
#     ⚠️ 몇 시간이면 만료됩니다. 401 이 뜨면 스크립트를 다시 돌리세요.
ANTHROPIC_AUTH_TOKEN=
#
# (B) 콘솔 API 키로 돌리기 (https://platform.claude.com → Settings → API keys)
ANTHROPIC_API_KEY=

CLAUDE_MODEL=claude-opus-5
