{
  "name": "@railhub/be",
  "version": "0.1.0",
  "private": true,
  "//": "빌드 스텝 없음 — FE가 TS 소스를 그대로 transpile 한다 (next.config.ts transpilePackages)",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:push": "tsx src/db/push.ts",
    "test:matching": "tsx src/matching.test.ts",
    "test:verify": "tsx src/report/verify.test.ts",
    "test:esg": "tsx src/esg/verify.test.ts && tsx src/esg/export.test.ts && tsx src/esg/guard.test.ts",
    "test:guard": "tsx src/report/guard.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.17.0",
    "@supabase/supabase-js": "^2.112.3",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "fflate": "^0.8.3",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  }
}
